{
  "compilerOptions": {
    "allowJs": true,
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ESNext", "dom"],
    "moduleResolution": "node",
    "esModuleInterop": true,
    "declaration": true,
    "declarationMap": true, 
    "emitDeclarationOnly": false,
    "outDir": "dist", 
    "rootDir": "src",
    "module": "esnext",
    "target": "esnext"
    },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", "dist"],
  "extends": "@dcl/sdk/types/tsconfig.ecs7.json"
}
